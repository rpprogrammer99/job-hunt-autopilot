# ============================================================
# Job Hunt Autopilot - Environment Example (placeholders only)
# Copy relevant blocks into:
#   - backend/.env         (backend secrets - NEVER commit)
#   - frontend/.env.local  (frontend Firebase WEB config - public, safe)
# NEVER put Firebase Admin / service-account credentials in the frontend.
# ============================================================

# ------------------------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------------------------

# Local dev: when true, the backend uses an in-memory store seeded from
# sample-data/ and (unless REQUIRE_AUTH=true) a reserved demo identity.
DEV_MODE=true

# Force a valid Firebase ID token on EVERY protected request (no demo bypass).
# Set true in production so demo identity can never be used.
REQUIRE_AUTH=false

# Google Cloud project id (Firestore + Gemini).
GOOGLE_CLOUD_PROJECT=

# Service account JSON for the backend (Firestore + token verification via
# Application Default Credentials). Leave empty locally to use the in-memory
# store. This file must NEVER be committed or shipped to the frontend.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Gen AI SDK (optional; app degrades to deterministic fallbacks).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_LOCATION=us-central1

# Shared secret for the protected scheduler endpoint.
SCHEDULER_TOKEN=change-me-local-dev-token

# Email import limit (bytes).
MAX_UPLOAD_BYTES=10485760

# CORS: comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# FRONTEND (frontend/.env.local) - Firebase WEB config.
# These values are PUBLIC by design (client SDK). They are NOT secrets.
# Do NOT put service-account keys or SCHEDULER_TOKEN here.
# ------------------------------------------------------------

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000

# Demo mode is OFF unless explicitly "true". When off, real Firebase Auth is
# required and demo data never mixes with a real account.
VITE_DEMO_MODE=false

# Point the client at the local Firebase emulator suite (see firebase.json).
VITE_USE_FIREBASE_EMULATOR=false

# Firebase web app config (from Firebase Console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
